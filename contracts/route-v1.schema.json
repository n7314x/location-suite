{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://location-suite.local/contracts/route-v1.schema.json",
  "title": "Location Suite Route v1",
  "description": "Portable waypoint-route representation shared by Location Suite clients and services.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "mode", "points", "speedProfile"],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^route_[A-Za-z0-9_-]+$",
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "mode": {
      "const": "walking"
    },
    "points": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "speedProfile": {
      "const": "natural"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": ["waypoint"]
        }
      }
    }
  }
}
